{
    "type": "srcds",
    "display": "SCP: Secret Laboratory",
    "data": {
        "port": {
            "type": "integer",
            "value": 7777,
            "display": "Port",
            "desc": "Port to bind the server to",
            "required": false,
            "userEdit": true
        }
    },
    "install": [
        {
            "if": "env == 'host'",
            "type": "steamgamedl",
            "appId": "996560"
        },
        {
            "if": "env == 'docker'",
            "type": "command",
            "commands": [
                "steamcmd +force_install_dir /pufferpanel +login anonymous +app_update 996560 +quit"
            ]
        }
    ],
    "run": {
        "command": "./LocalAdmin ${port}",
        "stop": "exit",
        "stdin": {
            "type": "stdin"
        },
        "autostart": false,
        "autorecover": false,
        "autorestart": false
    },
    "environment": {
        "type": "host"
    },
    "supportedEnvironments": [
        {
            "type": "host"
        },
        {
            "type": "docker",
            "image": "steamcmd/steamcmd"
        }
    ],
    "requirements": {
        "os": "linux",
        "arch": "amd64"
    },
    "stats": {
        "type": ""
    },
    "query": {
        "type": ""
    },
    "name": "scp-sl"
}
